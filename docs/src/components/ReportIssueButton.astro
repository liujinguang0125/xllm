import { buildReportIssueUrl, getReportIssueLabel } from '../lib/reportIssue';

const locale = Astro.locals.starlightRoute.locale;
// A 404 page has no documentation URL worth reporting, so the button is hidden there.
const isNotFound = /^(.*\/)?404$/.test(Astro.locals.starlightRoute.entry.id);
const reportUrl = buildReportIssueUrl(Astro.url.pathname);
const label = getReportIssueLabel(locale);
---

{!isNotFound && (
	<a class="report-issue" href={reportUrl} target="_blank" rel="noopener noreferrer">
		<svg aria-hidden="true" viewBox="0 0 24 24">
			<path d="M20 8h-2.81c-.45-.78-1.07-1.45-1.82-1.96L17 4.41 15.59 3l-2.17 2.17a6.002 6.002 0 0 0-5.83 0L5.41 3 4 4.41 5.62 6.04C4.88 6.55 4.26 7.22 3.81 8H1v2h2.09c-.05.33-.09.66-.09 1v1H1v2h2v1c0 .34.04.67.09 1H1v2h2.81c1.04 1.79 2.97 3 5.19 3s4.15-1.21 5.19-3H17v-2h-2.09c.05-.33.09-.66.09-1v-1h2v-2h-2v-1c0-.34-.04-.67-.09-1H20V8zm-6 8h-4v-2h4v2zm0-4h-4v-2h4v2z"></path>
		</svg>
		<span>{label}</span>
	</a>
)}

<style>
	@layer starlight.core {
		.report-issue {
			align-items: center;
			/*
			 * Deepened accent: white text on the raw accent color misses AA contrast.
			 * Mixed with black rather than `--sl-color-black`, which is white in the
			 * light theme and would lighten the pill.
			 */
			background-color: color-mix(in srgb, var(--docs-red) 78%, #000);
			border-radius: 999px;
			box-shadow: 0 0.25rem 0.75rem rgba(0, 0, 0, 0.25);
			color: #fff;
			display: inline-flex;
			font-size: 0.75rem;
			font-weight: 700;
			gap: 0.4rem;
			inset-block-end: 1.5rem;
			inset-inline-end: 1.5rem;
			line-height: 1;
			padding: 0.55rem 1.1rem;
			position: fixed;
			text-decoration: none;
			transition:
				background-color 0.2s,
				box-shadow 0.2s,
				transform 0.2s;
			/* Stay below the mobile menu so an open drawer covers the button. */
			z-index: 4;
		}

		.report-issue:is(:hover, :focus-visible) {
			background-color: color-mix(in srgb, var(--docs-red) 92%, #000);
			box-shadow: 0 0.375rem 1rem rgba(0, 0, 0, 0.3);
			transform: translateY(-1px);
		}

		.report-issue:focus-visible {
			outline: 2px solid var(--sl-color-text);
			outline-offset: 2px;
		}

		.report-issue svg {
			fill: currentColor;
			flex: 0 0 auto;
			height: 1.1em;
			width: 1.1em;
		}

		@media (max-width: 34rem) {
			.report-issue {
				inset-block-end: 1rem;
				inset-inline-end: 1rem;
			}
		}

		@media (prefers-reduced-motion: reduce) {
			.report-issue {
				transition:
					background-color 0.2s,
					box-shadow 0.2s;
			}

			.report-issue:is(:hover, :focus-visible) {
				transform: none;
			}
		}

		@media print {
			.report-issue {
				display: none;
			}
		}
	}
</style>
